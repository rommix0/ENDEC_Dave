; Loquendo "Dave" via the native x86 loqmsx codec.
; Mirrors the original ARM Dave.vde: SignalDescriptor gives the .sde unit index,
; BinFileName names the loqmsx .bin (engine reads coding "loqmsx" from the name).
"Include"		=	"EnglishUs6.9.lde"
"Description"		=	"American English male voice (Dave / loqmsx)"
"Name"			=	"Dave-19200"
"Gender"		=	"Male"
"Age"			=	"40"
"Idiolect"		=	"idiolect3"
"Lexicon[1]"		=	"EnglishUs/DaveEndec/Dave.lex"
"Baseline"		=	"45,95,200"
"Speed"			=	"50,128,250"
"SignalDescriptor[0]"	=	"EnglishUs/DaveEndec/Dave"
"BinFileName[0]"	=	"EnglishUs/DaveEndec/Dave-19200.16000.loqmsx.bin"
